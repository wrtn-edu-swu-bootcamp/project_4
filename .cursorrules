## 4. 코딩 규칙

### 4.1 JavaScript 규칙

```javascript
// ✅ 좋은 예
async function handleTextSelection(selectedText, position) {
  const normalized = normalizeText(selectedText);
  const term = await findTerm(normalized);
  
  if (term) {
    renderPopup(term, position);
  } else {
    renderNoMatchPopup(selectedText, position);
  }
}

// ❌ 나쁜 예 - 자동 스캔
function autoHighlightTerms() {
  const bodyText = document.body.innerText;
  // ... 페이지 전체 스캔 - 절대 금지!
}
```

**필수 패턴**:
- 모든 비동기 함수에 `async/await` 사용
- 에러 핸들링 필수 (`try/catch`)
- 디바운싱 적용 (텍스트 선택 이벤트는 200ms)
- 메모리 누수 방지 (이벤트 리스너 제거)

### 4.2 이벤트 처리

```javascript
// ✅ 필수: 디바운싱 적용
let debounceTimer = null;
const DEBOUNCE_DELAY = 200; // 200ms

document.addEventListener('mouseup', (e) => {
  if (debounceTimer) clearTimeout(debounceTimer);
  
  debounceTimer = setTimeout(() => {
    const selection = window.getSelection();
    const text = selection.toString().trim();
    
    if (isValidSelection(text)) {
      handleTextSelection(text, getSelectionPosition(selection));
    }
  }, DEBOUNCE_DELAY);
});

// ❌ 금지: 디바운싱 없는 처리
document.addEventListener('selectionchange', () => {
  handleSelection(); // 너무 자주 호출됨!
});
```

### 4.3 성능 최적화

**캐싱 (필수)**:
```javascript
// 용어 데이터 메모리 캐싱 (5분 TTL)
let cachedTerms = null;
let cacheTime = null;
const CACHE_TTL = 5 * 60 * 1000;

async function getCachedTerms() {
  if (cachedTerms && Date.now() - cacheTime < CACHE_TTL) {
    return cachedTerms;
  }
  
  cachedTerms = await getAllTerms();
  cacheTime = Date.now();
  return cachedTerms;
}
```

**Shadow DOM (필수)**:
```javascript
function createPopup(term, position) {
  const container = document.createElement('div');
  const shadow = container.attachShadow({ mode: 'open' });
  
  // 스타일 주입 (격리)
  const style = document.createElement('style');
  style.textContent = getPopupStyles();
  shadow.appendChild(style);
  
  // 콘텐츠 생성
  const popup = document.createElement('div');
  popup.innerHTML = generatePopupHTML(term);
  shadow.appendChild(popup);
  
  return container;
}
```

