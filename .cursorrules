## 11. 에러 핸들링

### 11.1 필수 에러 처리
```javascript
// 모든 비동기 함수에 try/catch
async function loadTerms() {
  try {
    const db = await initDB();
    const terms = await getAllTerms(db);
    return terms;
  } catch (error) {
    logger.error('Failed to load terms:', error);
    // Fallback: localStorage 또는 기본 데이터
    return getDefaultTerms();
  }
}

// 이벤트 리스너에서도 에러 처리
document.addEventListener('mouseup', async (e) => {
  try {
    await handleMouseUp(e);
  } catch (error) {
    logger.error('MouseUp error:', error);
  }
});
```

### 11.2 로깅 레벨
```javascript
// 개발: DEBUG 이상
// 프로덕션: WARN 이상
const LOG_LEVELS = {
  DEBUG: 0,
  INFO: 1,
  WARN: 2,
  ERROR: 3
};
```

