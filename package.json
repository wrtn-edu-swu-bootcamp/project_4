{
  "name": "financial-terms-extension",
  "version": "1.0.0",
  "description": "금융 용어 해설 Chrome 확장 프로그램 - 사용자가 선택한 금융 용어를 즉시 해설",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-extension.js",
    "build:vite": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "chrome-extension",
    "financial-terms",
    "banking",
    "education"
  ],
  "author": "judy0",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@vitejs/plugin-legacy": "^5.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^3.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
